# Copy this file to .env and fill in the values from Firebase Console >
# Project settings > Your apps > Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# The one email allowed to add and delete photos (same as in firestore.rules)
VITE_ADMIN_EMAIL=
